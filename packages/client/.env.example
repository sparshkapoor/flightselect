# Optional. Defaults to the relative path '/api', which works in both dev
# (Vite's dev-server proxy, see vite.config.ts) and production (nginx's /api
# proxy, see nginx/nginx.conf) without needing CORS. Only set this if serving
# the client from somewhere that can't reach the API at the same origin.
# VITE_API_BASE_URL=http://localhost:3001/api
